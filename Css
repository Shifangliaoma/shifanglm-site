:root {
    --primary-color: #0ef;
    --secondary-color: #f0f;
    --dark-color: #0a0a0a;
    --gray-color: #333;
    --light-gray: #444;
}

body {
    font-family: 'Roboto', sans-serif;
    background: var(--dark-color);
    color: #fff;
    line-height: 1.6;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 0;
}

.neon-header {
    background: linear-gradient(45deg, #0a0a0a, #1a1a1a);
    padding: 20px 0;
    text-align: center;
    border-bottom: 1px solid var(--primary-color);
    box-shadow: 0 0 20px rgba(0, 235, 255, 0.3);
}

.neon-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 2.5em;
    color: #fff;
    text-shadow: 0 0 10px var(--primary-color), 0 0 20px var(--primary-color);
    margin-bottom: 10px;
}

.neon-slogan {
    color: var(--primary-color);
    font-style: italic;
    text-shadow: 0 0 5px var(--primary-color);
}

.neon-nav ul {
    display: flex;
    justify-content: center;
    list-style: none;
    background: rgba(26, 26, 26, 0.8);
    padding: 10px 0;
    border-radius: 5px;
    backdrop-filter: blur(5px);
}

.neon-nav li {
    margin: 0 15px;
}

.neon-link {
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    padding: 5px 10px;
    border-radius: 3px;
    transition: all 0.3s ease;
    position: relative;
}

.neon-link:hover {
    color: var(--primary-color);
    text-shadow: 0 0 10px var(--primary-color);
}

.forum-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin: 40px 0;
}

.category-card {
    background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
    border: 1px solid var(--gray-color);
    border-radius: 10px;
    padding: 30px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.category-icon {
    width: 80px;
    height: 80px;
    background: var(--primary-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Orbitron', sans-serif;
    font-weight: bold;
    font-size: 1.2em;
    margin: 0 auto 20px;
    color: #000;
    box-shadow: 0 0 20px var(--primary-color);
}

.posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 20px;
}

.post-card {
    background: #1a1a1a;
    border: 1px solid var(--gray-color);
    border-radius: 8px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.post-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.post-price {
    background: var(--primary-color);
    color: #000;
    padding: 5px 10px;
    border-radius: 5px;
    font-weight: bold;
    font-family: 'Orbitron', sans-serif;
}

.post-meta {
    display: flex;
    justify-content: space-between;
    color: #888;
    font-size: 0.9em;
    margin-bottom: 10px;
}

.post-excerpt {
    color: #ccc;
    line-height: 1.5;
    margin-bottom: 15px;
}

.post-tags {
    display: flex;
    gap: 10px;
}

.tag {
    background: rgba(17, 114, 108, 0.3);
    color: var(--primary-color);
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 0.8em;
}

@keyframes borderAnimation {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

@media (max-width: 768px) {
    .container {
        width: 95%;
        padding: 10px 0;
    }
    
    .neon-title {
        font-size: 2em;
    }
    
    .posts-grid {
        grid-template-columns: 1fr;
    }
    
    .category-card {
        padding: 20px;
    }
}
