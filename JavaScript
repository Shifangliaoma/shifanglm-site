class UserSystem {
    constructor() {
        this.users = JSON.parse(localStorage.getItem('users') || '[]');
        this.currentUser = JSON.parse(localStorage.getItem('currentUser') || null);
    }
    
    register(username, password, email) {
        if (this.users.some(user => user.username === username)) {
            throw new Error('用户名已存在');
        }
        
        const newUser = {
            id: Date.now(),
            username,
            password: this.hashPassword(password),
            email,
            avatar: this.generateAvatar(username),
            points: 0,
            level: 1,
            title: '新手',
            role: 'user',
            status: 'active',
            createdAt: new Date().toISOString()
        };
        
        this.users.push(newUser);
        this.saveUsers();
        return newUser;
    }
    
    login(username, password) {
        const user = this.users.find(u => u.username === username && u.password === this.hashPassword(password));
        
        if (!user || user.status === 'banned') {
            throw new Error('用户名或密码错误，或账户已被封禁');
        }
        
        this.currentUser = user;
        localStorage.setItem('currentUser', JSON.stringify(user));
        return user;
    }
    
    generateAvatar(username) {
        return username.charAt(0).toUpperCase();
    }
    
    hashPassword(password) {
        return btoa(password);
    }
    
    saveUsers() {
        localStorage.setItem('users', JSON.stringify(this.users));
    }
    
    getLevelInfo(points) {
        const levels = [
            { min: 0, title: '新手', color: '#888' },
            { min: 100, title: '入门', color: '#0f0' },
            { min: 500, title: '进阶', color: '#0ff' },
            { min: 1000, title: '专家', color: '#f0f' },
            { min: 5000, title: '大师', color: '#ff0' }
        ];
        
        const level = levels.reverse().find(l => points >= l.min) || levels[0];
        return level;
    }
}

class PostSystem {
    constructor() {
        this.posts = JSON.parse(localStorage.getItem('posts') || '[]');
    }
    
    createPost(title, excerpt, content, price, category, authorId) {
        if (!this.canUserPost(authorId)) {
            throw new Error('只有作者身份的用户才能发帖');
        }
        
        const newPost = {
            id: Date.now(),
            title,
            excerpt,
            content,
            price,
            category,
            authorId,
            views: 0,
            likes: 0,
            createdAt: new Date().toISOString(),
            status: 'published'
        };
        
        this.posts.push(newPost);
        this.savePosts();
        return newPost;
    }
    
    canUserPost(userId) {
        const userSystem = new UserSystem();
        const user = userSystem.users.find(u => u.id === userId);
        return user && user.role === 'author' && user.status === 'active';
    }
    
    getPosts(category = null) {
        let filteredPosts = this.posts.filter(post => post.status === 'published');
        
        if (category) {
            filteredPosts = filteredPosts.filter(post => post.category === category);
        }
        
        return filteredPosts.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    }
    
    getPostById(id) {
        const post = this.posts.find(p => p.id === parseInt(id));
        if (post) {
            post.views++;
            this.savePosts();
        }
        return post;
    }
    
    savePosts() {
        localStorage.setItem('posts', JSON.stringify(this.posts));
    }
}

