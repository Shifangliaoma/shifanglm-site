* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Microsoft YaHei", sans-serif;
    outline: none;
}
body {
    background: #000;
    color: #fff;
    min-height: 100vh;
    background-image: radial-gradient(circle at 50% 50%, rgba(66, 153, 225, 0.1) 0%, transparent 60%),
                      linear-gradient(45deg, rgba(120, 119, 198, 0.05) 0%, transparent 50%);
    overflow-x: hidden;
}
.container {
    width: 100%;
    padding: 0 15px;
    margin: 0 auto;
}
/* 霓虹边框通用样式 */
.neon-border {
    box-shadow: 0 0 5px #4299e1, 0 0 10px #4299e1, 0 0 15px #4299e1;
    border: 1px solid rgba(66, 153, 225, 0.5);
}
/* 头部 */
header {
    background: rgba(0, 15, 30, 0.8);
    backdrop-filter: blur(8px);
    padding: 12px 0;
    border-bottom: 1px solid rgba(66, 153, 225, 0.3);
    position: sticky;
    top: 0;
    z-index: 99;
}
.header-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}
.logo {
    font-size: 22px;
    font-weight: bold;
    background: linear-gradient(90deg, #4299e1, #7877c6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: 1px;
}
.nav {
    display: flex;
    align-items: center;
    gap: 18px;
}
.nav a {
    color: #ddd;
    text-decoration: none;
    font-size: 15px;
    transition: all 0.3s;
    padding: 4px 8px;
    border-radius: 4px;
}
.nav a:hover {
    color: #4299e1;
    background: rgba(66, 153, 225, 0.1);
}
/* 按钮 */
.btn {
    padding: 7px 14px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.3s;
    font-weight: 500;
}
.btn-primary {
    background: linear-gradient(90deg, #4299e1, #5c6bc0);
    color: #fff;
    box-shadow: 0 0 5px rgba(66, 153, 225, 0.5);
}
.btn-primary:hover {
    box-shadow: 0 0 8px #4299e1, 0 0 12px #4299e1;
    transform: translateY(-1px);
}
.btn-danger {
    background: linear-gradient(90deg, #e53e3e, #ed8936);
    color: #fff;
    box-shadow: 0 0 5px rgba(229, 62, 62, 0.5);
}
.btn-danger:hover {
    box-shadow: 0 0 8px #e53e3e, 0 0 12px #e53e3e;
    transform: translateY(-1px);
}
/* 主体区域 */
section {
    padding: 25px 0;
}
/* 卡片 */
.card {
    background: rgba(0, 15, 30, 0.6);
    backdrop-filter: blur(5px);
    border-radius: 8px;
    padding: 22px;
    margin-bottom: 22px;
    border: 1px solid rgba(66, 153, 225, 0.3);
}
.card-title {
    font-size: 18px;
    margin-bottom: 18px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(66, 153, 225, 0.2);
    color: #4299e1;
    display: flex;
    align-items: center;
    gap: 8px;
}
.card-title::before {
    content: "";
    width: 4px;
    height: 18px;
    background: #4299e1;
    border-radius: 2px;
}
/* 表单 */
.form-group {
    margin-bottom: 18px;
}
.form-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
    color: #bbb;
    font-size: 14px;
}
.form-group input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid rgba(66, 153, 225, 0.3);
    border-radius: 4px;
    font-size: 14px;
    background: rgba(0, 20, 40, 0.5);
    color: #fff;
    transition: all 0.3s;
}
.form-group input:focus {
    border-color: #4299e1;
    box-shadow: 0 0 5px #4299e1;
}
.form-btn {
    text-align: center;
    margin-top: 10px;
}
/* 工具项 */
.tool-item {
    padding: 15px;
    border: 1px solid rgba(66, 153, 225, 0.2);
    border-radius: 6px;
    margin-bottom: 15px;
    opacity: 0.4;
    pointer-events: none;
    background: rgba(0, 20, 40, 0.3);
    transition: all 0.3s;
}
.tool-item.active {
    opacity: 1;
    pointer-events: all;
    box-shadow: 0 0 5px rgba(66, 153, 225, 0.3);
}
.tool-item h3 {
    color: #4299e1;
    font-size: 16px;
    margin-bottom: 8px;
}
.tool-item p {
    color: #ddd;
    font-size: 14px;
    line-height: 1.5;
}
/* 用户信息 */
.user-info {
    margin-bottom: 20px;
    font-size: 15px;
    line-height: 1.8;
}
.user-info span {
    color: #4299e1;
    font-weight: bold;
    text-shadow: 0 0 5px rgba(66, 153, 225, 0.5);
}
.recharge-link {
    color: #4299e1;
    text-decoration: none;
    margin-left: 8px;
    font-size: 14px;
    transition: all 0.3s;
}
.recharge-link:hover {
    text-decoration: underline;
    text-shadow: 0 0 5px #4299e1;
}
/* 表格 */
.admin-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    font-size: 14px;
}
.admin-table th, .admin-table td {
    padding: 10px 8px;
    border: 1px solid rgba(66, 153, 225, 0.2);
    text-align: left;
}
.admin-table th {
    background: rgba(66, 153, 225, 0.1);
    color: #4299e1;
}
.admin-table td {
    color: #ddd;
}
/* 弹窗 */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    z-index: 999;
    align-items: center;
    justify-content: center;
}
.modal-box {
    background: rgba(0, 15, 30, 0.9);
    backdrop-filter: blur(8px);
    border-radius: 8px;
    padding: 25px;
    width: 92%;
    max-width: 400px;
    border: 1px solid rgba(66, 153, 225, 0.5);
    box-shadow: 0 0 15px #4299e1;
}
/* 适配手机全屏 */
@media (max-width: 768px) {
    .header-box {
        flex-wrap: wrap;
        justify-content: space-between;
    }
    .nav {
        gap: 12px;
    }
    .nav a {
        font-size: 14px;
    }
    .btn {
        padding: 6px 12px;
        font-size: 13px;
    }
    .card {
        padding: 18px;
        margin-bottom: 18px;
    }
    .admin-table {
        font-size: 13px;
    }
    .admin-table th, .admin-table td {
        padding: 8px 6px;
    }
    .tool-item {
        padding: 12px;
    }
}
