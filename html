<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>十方料码论坛 - 专业的福彩3D与排列三交流平台</title>
    <style>
        :root {
            --primary: #0ff;
            --secondary: #f0f;
            --accent: #ff0;
            --dark-bg: #111;
            --darker-bg: #050505;
            --text: #eee;
            --neon-glow: 0 0 5px, 0 0 10px, 0 0 15px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }
        
        body {
            background-color: var(--darker-bg);
            color: var(--text);
            line-height: 1.6;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(0, 255, 255, 0.05) 0%, transparent 20%),
                radial-gradient(circle at 90% 80%, rgba(255, 0, 255, 0.05) 0%, transparent 20%);
            min-height: 100vh;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        /* 头部样式 */
        header {
            background-color: rgba(5, 5, 5, 0.8);
            border-bottom: 1px solid var(--primary);
            box-shadow: 0 0 10px var(--primary);
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(5px);
        }
        
        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary);
            text-shadow: var(--neon-glow) var(--primary);
            letter-spacing: 2px;
        }
        
        .logo span {
            color: var(--secondary);
            text-shadow: var(--neon-glow) var(--secondary);
        }
        
        nav ul {
            display: flex;
            list-style: none;
        }
        
        nav ul li {
            margin-left: 20px;
        }
        
        nav ul li a {
            color: var(--text);
            text-decoration: none;
            padding: 8px 15px;
            border-radius: 4px;
            transition: all 0.3s;
            position: relative;
        }
        
        nav ul li a:hover {
            color: var(--primary);
            text-shadow: 0 0 5px var(--primary);
        }
        
        nav ul li a.active {
            color: var(--primary);
            background-color: rgba(0, 255, 255, 0.1);
            box-shadow: 0 0 5px var(--primary);
        }
        
        .user-actions {
            display: flex;
            align-items: center;
        }
        
        .user-info {
            display: flex;
            align-items: center;
            margin-right: 15px;
        }
        
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-weight: bold;
            color: var(--dark-bg);
        }
        
        .btn {
            padding: 8px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }
        
        .btn-primary {
            background-color: var(--primary);
            color: var(--dark-bg);
            box-shadow: 0 0 5px var(--primary);
        }
        
        .btn-primary:hover {
            box-shadow: 0 0 15px var(--primary);
        }
        
        .btn-secondary {
            background-color: transparent;
            color: var(--secondary);
            border: 1px solid var(--secondary);
            box-shadow: 0 0 5px var(--secondary);
        }
        
        .btn-secondary:hover {
            box-shadow: 0 0 15px var(--secondary);
        }
        
        /* 主要内容区 */
        main {
            display: flex;
            margin-top: 30px;
            gap: 20px;
        }
        
        .content {
            flex: 3;
        }
        
        .sidebar {
            flex: 1;
        }
        
        .card {
            background-color: rgba(20, 20, 20, 0.7);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid rgba(0, 255, 255, 0.2);
            box-shadow: 0 0 10px rgba(0, 255, 255, 0.1);
            transition: all 0.3s;
        }
        
        .card:hover {
            box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
        }
        
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(0, 255, 255, 0.3);
        }
        
        .card-title {
            color: var(--primary);
            font-size: 1.2rem;
            text-shadow: 0 0 5px var(--primary);
        }
        
        /* 帖子列表 */
        .post-list {
            list-style: none;
        }
        
        .post-item {
            padding: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s;
        }
        
        .post-item:hover {
            background-color: rgba(0, 255, 255, 0.05);
        }
        
        .post-title {
            color: var(--text);
            font-size: 1.1rem;
            margin-bottom: 8px;
            display: block;
            text-decoration: none;
        }
        
        .post-title:hover {
            color: var(--primary);
        }
        
        .post-meta {
            display: flex;
            font-size: 0.85rem;
            color: #aaa;
        }
        
        .post-author {
            margin-right: 15px;
            display: flex;
            align-items: center;
        }
        
        .author-badge {
            background-color: var(--accent);
            color: var(--dark-bg);
            font-size: 0.7rem;
            padding: 2px 5px;
            border-radius: 3px;
            margin-left: 5px;
            font-weight: bold;
        }
        
        .post-stats {
            display: flex;
            gap: 15px;
        }
        
        .stat {
            display: flex;
            align-items: center;
        }
        
        .stat i {
            margin-right: 5px;
            color: var(--secondary);
        }
        
        /* 侧边栏 */
        .stats-card {
            display: flex;
            justify-content: space-between;
            text-align: center;
        }
        
        .stat-item {
            flex: 1;
        }
        
        .stat-value {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--primary);
            text-shadow: 0 0 5px var(--primary);
        }
        
        .stat-label {
            font-size: 0.85rem;
            color: #aaa;
        }
        
        .trending-list {
            list-style: none;
        }
        
        .trending-item {
            padding: 10px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .trending-item a {
            color: var(--text);
            text-decoration: none;
        }
        
        .trending-item a:hover {
            color: var(--primary);
        }
        
        /* 底部 */
        footer {
            margin-top: 50px;
            padding: 20px 0;
            text-align: center;
            border-top: 1px solid rgba(0, 255, 255, 0.3);
            color: #aaa;
            font-size: 0.9rem;
        }
        
        /* 模态框 */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        
        .modal-content {
            background-color: var(--dark-bg);
            border-radius: 8px;
            padding: 30px;
            width: 90%;
            max-width: 500px;
            border: 1px solid var(--primary);
            box-shadow: 0 0 20px var(--primary);
        }
        
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .modal-title {
            color: var(--primary);
            font-size: 1.5rem;
        }
        
        .close-btn {
            background: none;
            border: none;
            color: var(--text);
            font-size: 1.5rem;
            cursor: pointer;
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: var(--text);
        }
        
        .form-control {
            width: 100%;
            padding: 10px;
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 4px;
            color: var(--text);
        }
        
        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 5px var(--primary);
        }
        
        .form-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
        }
        
        .switch-form {
            color: var(--primary);
            cursor: pointer;
            text-decoration: underline;
        }
        
        /* 响应式设计 */
        @media (max-width: 768px) {
            main {
                flex-direction: column;
            }
            
            .header-content {
                flex-direction: column;
                gap: 15px;
            }
            
            nav ul {
                flex-wrap: wrap;
                justify-content: center;
            }
            
            nav ul li {
                margin: 5px;
            }
        }
    </style>
</head>
<body>
