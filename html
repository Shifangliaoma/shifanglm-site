<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>数字彩交流论坛 - 霓虹黑科技版</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box;}
        body{font-family:'Segoe UI',sans-serif;background:#050517;color:#e0e0ff;line-height:1.6;overflow-x:hidden;}
        /* 霓虹核心变量 */
        :root{
            --neon-cyan:#00f7ff;--neon-purple:#a855f7;--neon-pink:#ec4899;--neon-green:#34d399;--neon-gold:#fde047;
            --bg-card:rgba(15,15,40,0.7);--border-light:rgba(0,247,255,0.3);--shadow-neon:0 0 8px currentColor,0 0 15px currentColor;
        }
        /* 霓虹通用样式 */
        .neon-text-cyan{color:var(--neon-cyan);text-shadow:var(--shadow-neon);}
        .neon-text-purple{color:var(--neon-purple);text-shadow:var(--shadow-neon);}
        .neon-text-gold{color:var(--neon-gold);text-shadow:var(--shadow-neon);}
        .neon-border-cyan{border:1px solid var(--neon-cyan);box-shadow:var(--shadow-neon);}
        .neon-border-purple{border:1px solid var(--neon-purple);box-shadow:var(--shadow-neon);}
        .container{width:100%;max-width:1200px;margin:0 auto;padding:0 15px;}
        
        /* 顶部合规提示 */
        .top-alert{background:rgba(239,68,68,0.15);border-bottom:1px solid var(--neon-pink);text-align:center;padding:8px 0;font-size:14px;position:sticky;top:0;z-index:100;}
        
        /* 导航栏 */
        .header{background:rgba(5,5,23,0.9);backdrop-filter:blur(10px);padding:18px 0;position:sticky;top:34px;z-index:90;border-bottom:1px solid var(--border-light);}
        .nav-wrap{display:flex;justify-content:space-between;align-items:center;}
        .logo{font-size:24px;font-weight:700;neon-text-cyan;letter-spacing:1px;}
        .user-bar{display:flex;align-items:center;gap:12px;}
        .gold-info{display:flex;align-items:center;gap:5px;font-size:14px;neon-text-gold;}
        .gold-icon{font-size:18px;}
        .user-btn{padding:6px 12px;border-radius:6px;font-size:14px;text-decoration:none;transition:all 0.3s;}
        .login-btn{color:var(--neon-green);border:1px solid var(--neon-green);}
        .login-btn:hover{background:rgba(52,211,153,0.2);}
        .author-apply-btn{color:var(--neon-purple);border:1px solid var(--neon-purple);}
        .author-apply-btn:hover{background:rgba(168,85,247,0.2);}
        .admin-btn{color:var(--neon-pink);border:1px solid var(--neon-pink);}
        .admin-btn:hover{background:rgba(236,72,153,0.2);}
        .menu-toggle{width:44px;height:44px;background:transparent;border:none;color:var(--neon-cyan);font-size:26px;cursor:pointer;}
        .nav-menu{position:fixed;top:92px;left:0;right:0;background:rgba(5,5,23,0.95);backdrop-filter:blur(10px);display:none;flex-direction:column;z-index:80;border-bottom:1px solid var(--neon-cyan);}
        .nav-menu.active{display:flex;}
        .nav-item{padding:16px 20px;border-bottom:1px solid rgba(0,247,255,0.1);}
        .nav-item a{color:#e0e0ff;text-decoration:none;font-size:15px;transition:color 0.3s;}
        .nav-item a:hover{color:var(--neon-cyan);}
        .post-nav-btn{color:var(--neon-gold)!important;neon-text-gold;}
        
        /* 主体内容区 */
        .main-content{padding:20px 0 40px;}
        /* 分区入口 */
        .section-entry{margin-bottom:30px;}
        .section-title{font-size:20px;margin-bottom:20px;neon-text-purple;}
        .forum-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
        .forum-card{background:var(--bg-card);border-radius:12px;padding:25px;text-align:center;cursor:pointer;transition:transform 0.3s;neon-border-purple;}
        .forum-card:hover{transform:scale(1.03);}
        .forum-icon{font-size:40px;margin-bottom:15px;}
        .icon-3d{color:var(--neon-cyan);}
        .icon-pl3{color:var(--neon-pink);}
        .forum-name{font-size:18px;font-weight:600;margin-bottom:8px;}
        .forum-desc{font-size:13px;color:#a0a0cc;}
        
        /* 帖子列表通用样式 */
        .post-list-wrap{background:var(--bg-card);border-radius:12px;padding:20px;neon-border-cyan;}
        .list-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;}
        .list-title{font-size:18px;neon-text-cyan;}
        .post-btn{position:fixed;bottom:30px;right:30px;width:60px;height:60px;background:var(--neon-purple);border-radius:50%;color:#050517;font-size:28px;border:none;display:none;align-items:center;justify-content:center;box-shadow:var(--shadow-neon);z-index:70;cursor:pointer;transition:all 0.3s;}
        .post-btn.active{display:flex;}
        .post-btn:hover{background:var(--neon-gold);box-shadow:0 0 8px var(--neon-gold),0 0 15px var(--neon-gold);}
        .post-item{padding:15px 0;border-bottom:1px solid rgba(0,247,255,0.1);cursor:pointer;transition:background 0.2s;}
        .post-item:hover{background:rgba(0,247,255,0.05);}
        .post-item:last-child{border-bottom:none;}
        .post-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
        .post-author{font-size:13px;color:var(--neon-green);display:flex;align-items:center;gap:5px;}
        .author-tag{font-size:11px;background:rgba(52,211,153,0.2);border:1px solid var(--neon-green);border-radius:4px;padding:1px 6px;}
        .post-time{font-size:12px;color:#a0a0cc;}
        .post-title{font-size:16px;margin-bottom:5px;transition:color 0.3s;}
        .post-title:hover{color:var(--neon-cyan);}
        .post-meta{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:#a0a0cc;}
        .post-price{color:var(--neon-gold);neon-text-gold;}
        .post-sold{color:var(--neon-pink);}
        
        /* 帖子详情页 */
        .post-detail-wrap{background:var(--bg-card);border-radius:12px;padding:25px;neon-border-cyan;margin-bottom:20px;}
        .detail-header{margin-bottom:20px;}
        .detail-title{font-size:22px;margin-bottom:15px;neon-text-cyan;}
        .detail-meta{display:flex;flex-wrap:wrap;gap:15px;margin-bottom:15px;font-size:14px;}
        .meta-item{display:flex;align-items:center;gap:5px;}
        .meta-author{color:var(--neon-green);}
        .meta-time{color:#a0a0cc;}
        .meta-section{color:var(--neon-purple);}
        .meta-price{color:var(--neon-gold);neon-text-gold;}
        .detail-abstract{background:rgba(15,15,40,0.5);border-left:3px solid var(--neon-purple);padding:15px;margin-bottom:20px;border-radius:0 8px 8px 0;}
        .abstract-title{font-size:15px;margin-bottom:8px;color:var(--neon-purple);}
        .abstract-content{font-size:14px;color:#e0e0ff;line-height:1.7;}
        .detail-content{font-size:15px;line-height:1.8;}
        .detail-content p{margin-bottom:12px;}
        .detail-content b{color:var(--neon-cyan);}
        .buy-post-btn{display:block;width:100%;padding:14px 0;background:var(--neon-gold);color:#050517;font-size:16px;border:none;border-radius:8px;margin:20px 0;neon-text-gold;cursor:pointer;transition:all 0.3s;}
        .buy-post-btn:hover{background:var(--neon-yellow);transform:scale(1.02);}
        
        /* 评论区 */
        .comment-wrap{background:var(--bg-card);border-radius:12px;padding:25px;neon-border-purple;}
        .comment-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
        .comment-title{font-size:18px;neon-text-purple;}
        .comment-input{width:100%;padding:12px 15px;background:rgba(15,15,40,0.5);border:1px solid var(--neon-purple);border-radius:8px;min-height:100px;color:#e0e0ff;outline:none;margin-bottom:15px;resize:none;}
        .comment-submit{padding:8px 20px;background:var(--neon-purple);color:#050517;border:none;border-radius:6px;neon-text-purple;cursor:pointer;}
        .comment-list{margin-top:25px;}
        .comment-item{padding:15px 0;border-bottom:1px solid rgba(168,85,247,0.1);}
        .comment-author{font-size:13px;color:var(--neon-green);margin-bottom:8px;display:flex;align-items:center;gap:5px;}
        .comment-time{font-size:11px;color:#a0a0cc;margin-left:8px;}
        .comment-content{font-size:14px;}
        
        /* 底部 */
        .footer{background:rgba(5,5,23,0.9);padding:30px 0;border-top:1px solid var(--border-light);}
        .footer-content{text-align:center;font-size:13px;color:#a0a0cc;line-height:1.8;}
        .footer-content a{color:var(--neon-cyan);text-decoration:none;}
        
        /* 弹窗通用样式 */
        .modal{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(5,5,23,0.95);backdrop-filter:blur(8px);z-index:200;display:none;align-items:center;justify-content:center;padding:0 15px;}
        .modal.active{display:flex;}
        .modal-container{width:100%;max-width:600px;background:var(--bg-card);border-radius:12px;neon-border-cyan;overflow:hidden;}
        .modal-header{padding:18px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(0,247,255,0.1);}
        .modal-heading{font-size:18px;neon-text-cyan;}
        .modal-close{background:transparent;border:none;color:#a0a0cc;font-size:22px;cursor:pointer;transition:color 0.3s;}
        .modal-close:hover{color:var(--neon-pink);}
        .modal-body{padding:20px;}
        .form-group{margin-bottom:20px;}
        .form-label{display:block;font-size:14px;margin-bottom:8px;color:var(--neon-purple);}
        .form-control{width:100%;padding:12px 15px;background:rgba(15,15,40,0.5);border:1px solid var(--neon-cyan);border-radius:8px;color:#e0e0ff;outline:none;transition:box-shadow 0.3s;}
        .form-control:focus{box-shadow:0 0 8px var(--neon-cyan);}
        .modal-footer{padding:15px 20px;border-top:1px solid rgba(0,247,255,0.1);display:flex;justify-content:flex-end;gap:10px;}
        .modal-btn{padding:8px 20px;border-radius:6px;border:none;cursor:pointer;transition:all 0.3s;}
        .btn-cancel{background:rgba(15,15,40,0.5);color:#a0a0cc;}
        .btn-confirm{background:var(--neon-cyan);color:#050517;neon-text-cyan;}
        
        /* 登录注册弹窗 */
        .auth-modal .modal-container{max-width:420px;}
        .tab-group{display:flex;border-bottom:1px solid rgba(0,247,255,0.1);}
        .tab-btn{flex:1;padding:15px;text-align:center;background:transparent;border:none;color:#a0a0cc;cursor:pointer;transition:all 0.3s;}
        .tab-btn.active{color:var(--neon-cyan);border-bottom:2px solid var(--neon-cyan);}
        .tab-content{padding:20px 0;}
        .tab-panel{display:none;}
        .tab-panel.active{display:block;}
        .code-row{display:flex;gap:10px;}
        .code-input{flex:1;}
        .get-code-btn{padding:0 15px;background:var(--neon-purple);color:#050517;border:none;border-radius:8px;neon-text-purple;cursor:pointer;}
        
        /* 发帖弹窗 */
        .post-modal .modal-container{max-width:700px;}
        .price-select{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;}
        .price-option{padding:6px 12px;background:rgba(15,15,40,0.5);border:1px solid var(--neon-gold);border-radius:6px;color:var(--neon-gold);cursor:pointer;transition:all 0.3s;}
        .price-option.active{background:var(--neon-gold);color:#050517;}
        .editor-abstract{min-height:80px;}
        .editor-content{min-height:200px;}
        
        /* 作者申请弹窗 */
        .apply-modal .modal-container{max-width:500px;}
        
        /* 后台管理弹窗 */
        .admin-modal .modal-container{max-width:700px;}
        .admin-tab-group{display:flex;border-bottom:1px solid rgba(0,247,255,0.1);margin-bottom:20px;}
        .admin-tab-btn{flex:1;padding:12px;text-align:center;background:transparent;border:none;color:#a0a0cc;cursor:pointer;transition:all 0.3s;}
        .admin-tab-btn.active{color:var(--neon-pink);border-bottom:2px solid var(--neon-pink);}
        .admin-tab-panel{display:none;}
        .admin-tab-panel.active{display:block;}
        .admin-form-row{display:flex;gap:10px;margin-bottom:15px;}
        .admin-form-col{flex:1;}
        .admin-btn-group{display:flex;gap:10px;margin-top:10px;}
        .admin-btn{padding:8px 15px;border-radius:6px;border:none;cursor:pointer;}
        .btn-ban{background:var(--neon-pink);color:#050517;}
        .btn-delete{background:var(--neon-purple);color:#050517;}
        .btn-recharge{background:var(--neon-green);color:#050517;}
        .author-gold-list{max-height:250px;overflow-y:auto;margin-top:15px;padding:10px;background:rgba(15,15,40,0.5);border-radius:8px;}
        .author-gold-item{padding:8px 0;border-bottom:1px solid rgba(0,247,255,0.05);display:flex;justify-content:space-between;}
        .author-name{color:var(--neon-green);}
        .author-gold{color:var(--neon-gold);neon-text-gold;}
        
        /* 等级称号弹窗 */
        .level-modal .modal-container{max-width:450px;}
        .level-list{padding:10px 0;}
        .level-item{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(0,247,255,0.05);}
        .level-name{color:var(--neon-purple);display:flex;align-items:center;gap:5px;}
        .level-title{font-size:11px;background:rgba(168,85,247,0.2);border-radius:4px;padding:1px 6px;color:#e0e0ff;}
        .level-score{color:var(--neon-green);}
        
        /* 响应式适配 */
        @media (max-width:768px){
            .forum-grid{grid-template-columns:1fr;}
            .admin-form-row{flex-direction:column;gap:15px;}
            .detail-title{font-size:20px;}
            .post-btn{width:55px;height:55px;font-size:24px;bottom:20px;right:20px;}
        }
    </style>
</head>
<body>
    <!-- 合规提示 -->
    <div class="top-alert">
        理性购彩 量力而行 | 本平台仅做数字彩思路交流 无售彩/代买/包中承诺 | 元宝为虚拟积分 仅用于平台内帖子兑换
    </div>
    
    <!-- 导航栏 -->
    <header class="header">
        <div class="container nav-wrap">
            <div class="logo">数字彩交流论坛</div>
            <div class="user-bar">
                <div class="gold-info" id="userGold" style="display:none;">
                    <span class="gold-icon">💰</span>
                    <span id="goldNum">0</span> 元宝
                </div>
                <a href="javascript:;" class="user-btn login-btn" id="loginBtn">登录/注册</a>
                <a href="javascript:;" class="user-btn author-apply-btn" id="authorApplyBtn">申请作者</a>
                <a href="javascript:;" class="user-btn admin-btn" id="adminEnterBtn">后台管理</a>
                <button class="menu-toggle" id="menuToggle">☰</button>
            </div>
            <div class="nav-menu" id="navMenu">
                <div class="nav-item"><a href="javascript:;" id="homeNav">首页</a></div>
                <div class="nav-item"><a href="javascript:;" class="section-nav" data-section="3d">福彩3D交流区</a></div>
                <div class="nav-item"><a href="javascript:;" class="section-nav" data-section="pl3">排列三交流区</a></div>
                <div class="nav-item"><a href="javascript:;" id="levelNav">等级称号</a></div>
                <div class="nav-item"><a href="javascript:;" id="postNav" style="display:none;" class="post-nav-btn">发布帖子</a></div>
                <div class="nav-item"><a href="javascript:;" id="logoutNav" style="display:none;color:var(--neon-pink);">退出登录</a></div>
            </div>
        </div>
    </header>
    
    <!-- 主体内容 -->
    <div class="container main-content">
        <!-- 首页内容 -->
        <div id="homeContent" style="display:block;">
            <div class="section-entry">
                <h2 class="section-title neon-text-purple">论坛分区</h2>
                <div class="forum-grid">
                    <div class="forum-card section-card" data-section="3d">
                        <div class="forum-icon icon-3d">📊</div>
                        <div class="forum-name">福彩3D交流区</div>
                        <div class="forum-desc">走势分析·缩水技巧·实战心得</div>
                    </div>
                    <div class="forum-card section-card" data-section="pl3">
                        <div class="forum-icon icon-pl3">🔢</div>
                        <div class="forum-name">排列三交流区</div>
                        <div class="forum-desc">数字规律·选号思路·成果分享</div>
                    </div>
                </div>
            </div>
            
            <h2 class="section-title neon-text-purple">最新帖子</h2>
            <div class="post-list-wrap" id="latestPostList">
                <!-- 脚本动态渲染 -->
            </div>
        </div>
        
        <!-- 分区帖子列表 -->
        <div id="sectionPostContent" style="display:none;">
            <a href="javascript:;" class="user-btn login-btn" style="margin-bottom:15px;" id="backHomeBtn">← 返回首页</a>
            <h2 class="section-title" id="sectionPostTitle"></h2>
            <div class="post-list-wrap" id="sectionPostList">
                <!-- 脚本动态渲染 -->
            </div>
            <button class="post-btn active" id="sectionPostBtn" style="display:none;">✍️</button>
        </div>
        
        <!-- 帖子详情 -->
        <div id="postDetailContent" style="display:none;">
            <a href="javascript:;" class="user-btn login-btn" style="margin-bottom:15px;" id="backSectionBtn">← 返回列表</a>
            <div class="post-detail-wrap">
                <div class="detail-header">
                    <h1 class="detail-title" id="detailPostTitle"></h1>
                    <div class="detail-meta">
                        <div class="meta-item meta-author">
                            <span id="detailAuthor">作者</span>
                            <span class="author-tag" id="detailAuthorLevel">Lv.1 新手</span>
                        </div>
                        <div class="meta-item meta-time" id="detailPostTime"></div>
                        <div class="meta-item meta-section" id="detailPostSection"></div>
                        <div class="meta-item meta-price" id="detailPostPrice"></div>
                    </div>
                    <div class="detail-abstract">
                        <h3 class="abstract-title">帖子摘要</h3>
                        <div class="abstract-content" id="detailPostAbstract"></div>
                    </div>
                    <div class="detail-content" id="detailPostContent">
                        <!-- 购买后显示正文 -->
                        <p style="text-align:center;padding:30px;color:#a0a0cc;">该帖子需购买后查看正文内容</p>
                    </div>
                    <button class="buy-post-btn" id="detailBuyBtn">购买查看</button>
                </div>
            </div>
            
            <div class="comment-wrap">
                <div class="comment-header">
                    <h3 class="comment-title">评论区</h3>
                </div>
                <textarea class="comment-input" id="commentInput" placeholder="请输入评论内容（登录后可评论）" disabled></textarea>
                <button class="comment-submit" id="commentSubmitBtn" disabled>提交评论</button>
                <div class="comment-list" id="detailCommentList">
                    <!-- 脚本动态渲染 -->
                </div>
            </div>
        </div>
    </div>
    
    <!-- 发帖按钮（固定） -->
    <button class="post-btn" id="homePostBtn" style="display:none;">✍️</button>
    
    <!-- 底部 -->
    <footer class="footer">
        <div class="container footer-content">
            <p>© 2025 数字彩交流论坛 版权所有</p>
            <p>ICP备案号：粤ICP备XXXXXXXX号-1 | 公安备案号：XXXXXXXXXXXX</p>
            <p><a href="#">合规声明</a> | 理性购彩 快乐常在 | 1元宝=1元 仅平台内帖子兑换使用</p>
        </div>
    </footer>
    
    <!-- 登录注册弹窗 -->
    <div class="modal auth-modal" id="loginRegModal">
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-heading">用户登录/注册</h3>
                <button class="modal-close" id="closeLoginRegModal">×</button>
            </div>
            <div class="tab-group">
                <button class="tab-btn active" data-tab="login">登录</button>
                <button class="tab-btn" data-tab="register">注册</button>
            </div>
            <div class="modal-body">
                <div class="tab-content">
                    <!-- 登录面板 -->
                    <div class="tab-panel active" id="loginPanel">
                        <div class="form-group">
                            <label class="form-label">手机号</label>
                            <input type="tel" class="form-control" id="loginPhone" placeholder="请输入手机号" maxlength="11">
                        </div>
                        <div class="form-group">
                            <label class="form-label">密码</label>
                            <input type="password" class="form-control" id="loginPwd" placeholder="请输入密码">
                        </div>
                        <button class="modal-btn btn-confirm" style="width:100%;" id="doLoginBtn">登录</button>
                    </div>
                    <!-- 注册面板 -->
                    <div class="tab-panel" id="registerPanel">
                        <div class="form-group">
                            <label class="form-label">手机号</label>
                            <input type="tel" class="form-control" id="regPhone" placeholder="请输入手机号" maxlength="11">
                        </div>
                        <div class="form-group">
                            <label class="form-label">验证码</label>
                            <div class="code-row">
                                <input type="text" class="form-control code-input" id="regCode" placeholder="请输入验证码">
                                <button class="get-code-btn" id="getRegCodeBtn">获取验证码</button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">密码</label>
                            <input type="password" class="form-control" id="regPwd" placeholder="请设置密码（6-16位）">
